# ============================================================
# EcoSense — Environment Variables Template
# ============================================================

# Groq API Key (starts with gsk_)
# Retrieve from https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Encryption key for securing local storage data
VITE_STORAGE_KEY=ecosense-local-key-super-secret

# Proxy Server Port
PORT=3001
